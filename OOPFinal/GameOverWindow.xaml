<Window x:Class="UI.GameOverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="GameOverWindow" Height="450" Width="800">
    <Grid Background="{StaticResource backgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Label x:Name="lblResult" Grid.Row="0" FontSize="32" Foreground="Gold" VerticalAlignment="Center" HorizontalAlignment="Center"></Label>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="6*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Content="Previous Game Data" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" Foreground="{StaticResource forgroundColor}" FontSize="16"></Label>
            <ListBox x:Name="lstRecords" Grid.Row="1" Margin="12px" Background="{StaticResource bubbleColor}" Foreground="{StaticResource forgroundColor}"></ListBox>
        </Grid>
        <Button Grid.Row="2" Content="Thanks For Playing!" Width="200px" Height="70px" Background="{StaticResource bubbleColor}" Foreground="{StaticResource forgroundColor}" Click="Button_Click"></Button>

    </Grid>
</Window>
