<Window x:Class="UI.BattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        Title="Battle" Height="450" Width="800" Initialized="Window_Initialized">
    <Grid Background="#FFFFA5A5">
        <Label Content="Enemy" HorizontalAlignment="Left" Margin="528,-2,0,0" VerticalAlignment="Top" Width="196"/>
        <TextBlock x:Name="EnemyLabel" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="230,29,0,0" VerticalAlignment="Top" Width="196" Height="116"/>
        <Label x:Name="PlayerLabel" Content=""  HorizontalAlignment="Left" Margin="0,217,0,0" VerticalAlignment="Top" Width="154"/>
        <Label Content="Player" HorizontalAlignment="Left" Margin="0,191,0,0" VerticalAlignment="Top" Width="141"/>
        <Ellipse Height="52" Margin="546,215,94,0" Stroke="Black" VerticalAlignment="Top" Fill="Black"/>
        <Image HorizontalAlignment="Left" Height="185" Margin="0,249,0,0" VerticalAlignment="Top" Width="158" Source="/image.psd.png">
        </Image>
        <Image HorizontalAlignment="Left" Height="196" Margin="528,47,0,0" VerticalAlignment="Top" Width="203" Source="/pixil-frame-0(1).png"/>

    </Grid>
</Window>
