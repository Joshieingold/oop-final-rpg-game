<Window x:Class="GameUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOPFinal"
        mc:Ignorable="d"
        Title="RPG GAME - Title Screen" Height="450" Width="800">
    <Grid Margin="10,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="39*"/>
            <RowDefinition Height="23*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Just a normal week at NBCC" TextAlignment="Center" Margin="10,101,10,89" FontSize="36" ></TextBlock>
        <TextBox x:Name="txtUsername" Margin="244,217,244,0" Height="35" VerticalAlignment="Top" />
        <Button Content="New Game" Click="Button_Click" Margin="244,55,244,0" Height="32" VerticalAlignment="Top" Grid.Row="1"></Button>
    </Grid>
</Window>
